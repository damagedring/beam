{
  "name": "beam",
  "version": "0.13.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "serve": "node tools/serve.mjs",
    "check:maintenance": "node tools/check-maintenance.mjs && npm run check:types",
    "test": "npm run build && npm run test:unit && playwright test",
    "test:unit": "node --test tests/*.test.mjs tests/*.test.cjs",
    "test:flow": "playwright test flow.spec.mjs",
    "test:visual": "playwright test appearance.visual.spec.mjs",
    "test:perf": "playwright test --config playwright.perf.config.mjs",
    "check:types": "tsc --project tools/tsconfig.completions.json"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "es-module-lexer": "3.0.5",
    "typescript": "5.9.3"
  }
}
